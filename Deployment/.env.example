# RSP Dashboard - LAN deployment environment file.
#
# Workflow:
#   1. cp .env.example .env
#   2. Edit .env and set ADMIN_SECRET to a strong password.
#   3. chmod 600 .env       (so only the deploying user can read it)
#   4. ./deploy.sh          (or .\deploy.ps1 on Windows)
#
# Never commit .env. The .gitignore in this folder already excludes it.

# --- REQUIRED ---------------------------------------------------------------

# Dashboard admin user password.
# Used by Dashboard/server/services/auth.py to authenticate the `admin` user.
# Accepts plaintext OR a bcrypt hash. Change this BEFORE running deploy.
ADMIN_SECRET=changeme

# --- OPTIONAL (defaults are fine for most deployments) ----------------------

# Image tag to run. Defaults to whatever was baked in by Deployment/build.sh
# at bundle time (currently 1.1.0). Pin a real version in production.
# IMAGE_TAG=1.1.0

# Host port mappings.
# CLIENT_PORT=3000
# SERVER_PORT=8000

# Slow-request threshold (milliseconds). Requests above this are tagged
# event="slow_request" in /app/logs/server/app.log.
# SLOW_QUERY_MS=1000
